# 발급된 Google Calendar ID를 명시. 다른 calendarId 입력은 무시합니다.
CALSYNC_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# 실제 공개 도메인의 scheme + hostname (경로 없이)
CALSYNC_PUBLIC_ORIGIN=https://calendar.example.com
# 사용자 계정은 docker compose exec -it calsync python -m app.security add-user --username ... 으로 생성
# 비밀번호 해시는 SQLite DB에만 보관되며 로그인 세션은 서버에서 만료/폐기 가능합니다.
CALSYNC_DATABASE=/data/calsync.db
CALSYNC_GOOGLE_TOKEN_FILE=/run/secrets/google-token.json
CALSYNC_SESSION_MAX_AGE_SECONDS=43200

# 호스트 계정의 id -u / id -g 결과로 설정
CALSYNC_UID=1000
CALSYNC_GID=1000
